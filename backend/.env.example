# ===== Embedding 模型配置 =====
EMBEDDING_API_KEY=sk-your-embedding-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=

# ===== LLM 对话模型配置 =====
LLM_PROVIDER=openai                    # openai / claude
LLM_API_KEY=sk-your-llm-key-here
LLM_CHAT_MODEL=gpt-4o-mini
LLM_BASE_URL=                          # 可选，自定义 API 地址（代理/中转）

# ===== Reranker 重排序模型 =====
RERANKER_MODEL=bge-reranker-v2-m3
RERANKER_BASE_URL=
RERANKER_API_KEY=                      # 不填则复用 EMBEDDING_API_KEY

# ===== 生成参数 =====
MAX_CONTEXT_TOKENS=3000

# ===== 拒答阈值（基于 BGE-Reranker L3 分数）=====
ABSTAIN_HARD_THRESHOLD=0.1            # 最高分 < 此值 → 硬拒答，跳过 LLM
ABSTAIN_SOFT_THRESHOLD=0.3            # 最高分 < 此值 → 软拒答，Prompt 中注入强拒答指令

# ===== 访问控制 =====
ACCESS_TOKEN=                          # 访问令牌，不填则不做限制

# ===== 向量 & 存储 =====
CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
DATABASE_URL=sqlite:///./data/conversations.db

# ===== 服务 =====
PORT=8001
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8001
